{
  "id": "/",
  "name": "DocBrisk: Free PDF & Document Tools",
  "short_name": "DocBrisk",
  "description": "Compress, convert, merge and sign PDFs, make biodata, letters and passport photos. Works in your browser; files are never uploaded.",
  "lang": "en-IN",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f3eee5",
  "theme_color": "#4f46e5",
  "categories": ["productivity", "utilities", "business"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Compress PDF", "url": "/tool/compress-pdf", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Word to PDF", "url": "/tool/word-to-pdf", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Biodata Maker", "url": "/tool/biodata-maker", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Merge PDF", "url": "/tool/merge-pdf", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{
        "name": "files",
        "accept": ["application/pdf", ".pdf", "image/jpeg", "image/png", "image/webp", ".jpg", ".jpeg", ".png", ".webp",
                   "application/vnd.openxmlformats-officedocument.wordprocessingml.document", ".docx",
                   "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", ".xlsx", "text/csv", ".csv"]
      }]
    }
  },
  "file_handlers": [{
    "action": "/",
    "accept": {
      "application/pdf": [".pdf"],
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
      "text/csv": [".csv"],
      "image/jpeg": [".jpg", ".jpeg"],
      "image/png": [".png"],
      "image/webp": [".webp"]
    }
  }]
}
